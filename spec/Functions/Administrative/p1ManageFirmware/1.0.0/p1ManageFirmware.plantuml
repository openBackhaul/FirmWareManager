@startuml p1ManageFirmware
skinparam responseMessageBelowArrow true

title
  p1ManageFirmware
end title

participant "embedYourself\n" as embed
participant "p1ManageFirmware\n" as p1ManaFw
participant "p1LoadParameters\n" as p1LP
participant "p1ResolveEsAddress\n" as p1REA
participant "p1CreateDomainController\nFromStartupDS" as p1CDCFS #Orange
participant "p1Pulser\n" as p1Puls

note right embed
  Automatically starts
  p1ManageFirmware
end note
embed -> p1ManaFw : {}
activate p1ManaFw

  p1ManaFw -> p1LP : {functionName=\n"p1ManageFirmware"}
  activate p1LP
    note over p1LP
      Loads parameters
      from configFile
    end note
  p1ManaFw <-- p1LP : { {parameters},\n{configFile} }
  deactivate p1LP

  note over p1ManaFw #Orange
    Minimum an Parametern zum Starten der Applikation.
    z.B. ES Adressen, um von dort die Parameter etc. zu laden.
  end note

  loop FOR all esName
    p1ManaFw -> p1REA : { {/parameters/sub-function=p1ResolveEsAddress},\n{configFile},\nesName }
    activate p1REA
      note over p1REA
        Resolves ES address
      end note
    p1ManaFw <-- p1REA : { {esAddress} }
    deactivate p1REA
  end loop
  note over p1ManaFw #Orange
    Ich erwarte zwei ES-Adressen:
      - DomainController, inkl. StartupDS
      - MWDI
    Wie/Wo sollen diese Adressen gespeichert werden?
      - Durchreichen an Funktionen?
      - Zusätzliche Klasse für EsAdressen an DomainController?
  end note

  p1ManaFw -> p1CDCFS : { {StartupDsEsAddress} }
  activate p1CDCFS
    note over p1CDCFS
      Creates DomainController
      from StartupDS
    end note
  p1ManaFw <-- p1CDCFS
  deactivate p1CDCFS
  
  p1ManaFw -> p1Puls : { {/parameters/sub-function=p1Pulser} }
  activate p1Puls
    loop endless
      note over p1Puls
        Invokes functions
        cyclically 
      end note
    end loop
  p1ManaFw <-- p1Puls : { {parameters}\n{configFile} }
  deactivate p1Puls

@enduml
