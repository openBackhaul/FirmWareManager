@startuml p1CreateDcFromStartupDS
skinparam responseMessageBelowArrow true

title
  p1CreateDcFromStartupDS
end title

participant "requestor\n" as requestor
participant "p1CreateDc\nFromStartupDS" as p1CDCFS
participant "p1LoadParameters\n" as p1LP
database "ElasticSearch" as StartDS
database "DomainController" as DC
database "ErrorList" as hEL

requestor -> p1CDCFS
activate p1CDCFS
  note over p1CDCFS
    Populates DomainController
    from ElasticSearch
  end note

  note over p1CDCFS
    Reads esName of FWM's
    ElasticSearch index from
    configFile
  end note
  p1CDCFS -> p1LP : {functionName=\n"p1CreateDcFromStartupDS"}
  activate p1LP
    note over p1LP
      Loads parameters
      from configFile
    end note
  p1CDCFS <-- p1LP : { esName==domainControllerEsClient, ... }
  deactivate p1LP
  note over p1CDCFS
    IF error
  end note
  note right p1CDCFS
    THEN {
  end note
  p1CDCFS -> hEL : {functionName="p1LoadParameters",\nerrorMessage1}
  requestor <-- p1CDCFS : { ErrorCode,\nErrorMessage1 }
  note right p1CDCFS
    }
  end note

  note over p1CDCFS
    Reads ElasticSearchClient
    address from [EsAddress]
  end note
  p1CDCFS -> DC: {/domain-controller/es-address=domainControllerEsClient}
  activate DC
  p1CDCFS <-- DC: {DomainControllerEsClient}
  deactivate DC
  note over p1CDCFS
    IF error
  end note
  note right p1CDCFS
    THEN {
  end note
  p1CDCFS -> hEL : {functionName="p1CreateDcFromStartupDS",\nerrorMessage2}
  requestor <-- p1CDCFS : { ErrorCode,\nerrorMessage2 }
  note right p1CDCFS
    }
  end note

  note over p1CDCFS
    Loads DomainController
    from ElasticSearch
  end note
  p1CDCFS -> StartDS: { DomainControllerEsClient://domain-controller }
  activate StartDS
  p1CDCFS <-- StartDS: {DomainController}
  deactivate StartDS
  note over p1CDCFS
    IF error
  end note
  note right p1CDCFS
    THEN {
  end note
  p1CDCFS -> hEL : {functionName="p1CreateDcFromStartupDS",\nerrorMessage3}
  requestor <-- p1CDCFS : { ErrorCode,\nErrorMessage3 }
  note right p1CDCFS
    }
  end note

  note over p1CDCFS
    Populates
    DomainController
    from {DomainController}
  end note
  p1CDCFS -> DC: [Function]
  p1CDCFS -> DC: [ValidationSequence]
  p1CDCFS -> DC: [Pulser]
  p1CDCFS -> DC: [ToDoCode]
  p1CDCFS -> DC: [ToDoList]
  note over p1CDCFS
    IF error
  end note
  note right p1CDCFS
    THEN {
  end note
  p1CDCFS -> hEL : {functionName="p1CreateDcFromStartupDS",\nerrorMessage4}
  requestor <-- p1CDCFS : { ErrorCode,\nErrorMessage4 }
  note right p1CDCFS
    }
  end note

  note over p1CDCFS
    Populates RunningDS
    from StartupDS in
    {DomainController}
  end note
  p1CDCFS -> DC: [RunningDS]
  note over p1CDCFS
    IF error
  end note
  note right p1CDCFS
    THEN {
  end note
  p1CDCFS -> hEL : {functionName="p1CreateDcFromStartupDS",\nerrorMessage5}
  requestor <-- p1CDCFS : { ErrorCode,\nErrorMessage5 }
  note right p1CDCFS
    }
  end note

requestor <-- p1CDCFS: 204
deactivate p1CDCFS

@enduml
