@startuml p1CreateDevices
skinparam responseMessageBelowArrow true

title
  p1CreateDevices
end title

participant "pulser\n" as pulser
participant "p1CreateDevices\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS
database "OperationalDS" as OpDS


pulser -> cur
activate cur

  note over cur
    Reads list of ODS:Devices
  end note
  cur -> OpDS
  activate OpDS
  cur <-- OpDS
  deactivate OpDS
  loop for each ODS:Device
    note over cur
      Checks, whether it can
      be found in RDS:Devices
    end note
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
    note over cur
      IF cannot be found:
    end note
    note right cur
      THEN
    end note
    note right cur
      Add mountName and deviceModel
      of ODS:Device to [newDevice]
    end note
    note over cur
      ELSE
    end note
  end loop
  note over cur
    IF [newDevice].length = 0:
  end note
  note left cur
    THEN
  end note
  pulser <-- cur: 204
  note over cur
    ELSE
  end note  

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  loop for [newDevice]
    note over cur
      Creates new RDS:Devices
    end note
    cur -> CanDS
    cur <-- CanDS

    note over cur
      Adds new RDS:Device
      to default DeviceGroup
    end note
    note over cur
      Attempts to address DeviceModel
      referenced in deviceModel of
      RDS:Device for reading its 
      defaultDeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS
    note over cur
      IF DeviceModel does not exist:
    end note
    note right cur
      THEN
    end note
    note right cur
      No further action
      at this Device
    end note
    note over cur
      ELSE
    end note
    note over cur
      Adds mountName of RDS:Device
      to [device] at defaultDeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS

    note over cur
      Transfers content of
      [targetFirmwareList]
      of defaultDeviceGroup
      to [firmwareList] at
      RDS:Device
    end note
    note right cur
      Reads [targetFirmwareList]
      at defaultDeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS
    note right cur
      Updates [firmwareList]
      at RDS:Device
    end note
    cur -> CanDS
    cur <-- CanDS
  end loop

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

pulser <-- cur: 204
deactivate cur

@enduml