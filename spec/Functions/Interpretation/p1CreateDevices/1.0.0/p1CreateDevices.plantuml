@startuml p1CreateDevices
skinparam responseMessageBelowArrow true

title
  p1CreateDevices
end title

participant "pulser\n" as requestor
participant "p1CreateDevices\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS
database "OperationalDS" as OpDS

requestor -> indServ
activate indServ

  loop for each ODS:Device
    note over indServ
      Reads ODS:Device
    end note
    indServ -> OpDS
    activate OpDS
    indServ <-- OpDS: {mountName, deviceModel, ...}
    deactivate OpDS
    note over indServ
      Checks, whether mountName can
      be found in RDS:[Device]
    end note
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS
    deactivate RunDS
    note over indServ
      IF cannot be found:
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      Creates a new entry in [{newDevice}]
      from mountName and deviceModel of
      ODS:Device
    end note
    note right indServ
      }
    end note
  end loop
  note over indServ
    IF [{newDevice}].length==0:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: 204
  note left indServ
    }
  end note  

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  loop for each newDevice
    note over indServ
      Creates new RDS:Device from
      mountName and deviceModel
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Attempts to add new RDS:Device
      to its default DeviceGroup
    end note
    note right indServ
      Attempts to read the
      defaultDeviceGroup
      at deviceModel
    end note
    indServ -> CanDS
    indServ <-- CanDS: defaultDeviceGroup
    note right indServ
      IF DeviceModel does not exist:
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      No further action
      at this new Device
    end note
    note right indServ
      }
    end note
    note right indServ
      Adds mountName of RDS:Device
      to [device] at defaultDeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS
 
    note over indServ
      Transfers content of
      [targetFirmwareList]
      of defaultDeviceGroup
      to [firmwareList] at
      new RDS:Device
    end note
    note right indServ
      Reads [targetFirmwareList]
      at defaultDeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS
    note right indServ
      Updates [firmwareList]
      at RDS:Device
    end note
    indServ -> CanDS
    indServ <-- CanDS
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==addDevicesToDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage1 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
