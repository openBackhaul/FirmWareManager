@startuml p2MeasureDevice
skinparam responseMessageBelowArrow true

title
  p2MeasureDevice
end title

participant "requestor\n" as requestor
participant "p2MeasureDevice\n" as indServ
participant "p1CreateOperational\nDevice" as createDev
participant "p1CompleteDevice\nObject" as completeDev
participant "p2MeasureHw\n" as updateHw
participant "p1MeasureFw\n" as updateFw

database "DomainController" as DC
database "OperationalDS" as OpDS

requestor -> indServ: updatedMountName,\nCC
activate indServ
  note over indServ
    Reads function names for 
      - createDeviceFunction
      - completeDeviceObjectFunction
      - measureHardwareFunction
      - measureFirmwareFunction
    from parameters
  end note
  indServ -> DC
  activate DC
  indServ <-- DC: createDeviceFunctionName,\ncompleteDeviceObjectFunctionName,\nmeasureHardwareFunctionName,\nmeasureFirmwareFunctionName
  deactivate DC

  note over indServ
    Checks, whether updatedMountName
    already exists in ODS:[Device]
  end note
  indServ -> OpDS: /domain-controller/network-control-domain=operational/device=updatedMountName/mount-name
  activate OpDS
  indServ <-- OpDS
  deactivate OpDS
  note over indServ
    IF NOT existing:
  end note
  note right indServ
    THEN {
  end note
  indServ -> createDev: updatedMountName,\nCC
  activate createDev
    note over createDev
      Creates device object
      in OperationalDS
    end note
  indServ <-- createDev
  deactivate createDev
  note right indServ
    }
  end note

  note over indServ
    Checks, whether Device object
    completed in ODS:[Device]
  end note
  indServ -> OpDS: /domain-controller/network-control-domain=operational/device=updatedMountName/firmware-list

  activate OpDS
  indServ <-- OpDS
  deactivate OpDS
  note over indServ
    IF NOT completed:
  end note
  note right indServ
    THEN {
  end note
  indServ -> completeDev: updatedMountName,\nCC
  activate completeDev
    note over completeDev
      Completes device object
      in OperationalDS
    end note
  indServ <-- completeDev
  deactivate completeDev
  note right indServ
    }
  end note

  indServ -> updateHw: updatedMountName,\nCC
  activate updateHw
    note over updateHw
      Updates deviceModel
      specific hardware
      dependencies in
      OperationalDS
    end note
  indServ <-- updateHw
  deactivate updateHw

  indServ -> updateFw: updatedMountName,\nCC
  activate updateFw
    note over updateFw
      Updates deviceModel
      specific firmware
      composition in
      OperationalDS
    end note
  indServ <-- updateFw
  deactivate updateFw

  note over indServ
    Overwrites
    lastMeasurementTime
    with current timestamp
  end note
  indServ -> OpDS: lastMeasurementTime

requestor <-- indServ: ok
deactivate indServ

@enduml
