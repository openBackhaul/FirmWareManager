@startuml p1ComplementSeparatedAppToo
skinparam responseMessageBelowArrow true

title
  p1ComplementSeparatedAppToo
end title

participant "requestor\n" as requestor
participant "p1ComplementSeparatedAppToo\n" as indServ

database "OperationalDS" as OpDS

requestor -> indServ: updatedMountName,\nCC
activate indServ

  note over indServ
    Instantiates [firmwareList]=[ ]
  end note
  note over indServ
    Adds [firmwareList] to
    Device in OperationalDS
  end note
  indServ -> OpDS: [firmwareList]

  note over indServ
    Instantiates [applicationFirmwareList]=[ ]
  end note
  note over indServ
    Adds [applicationFirmwareList]
    to Device in OperationalDS
  end note
  indServ -> OpDS: [applicationFirmwareList]

requestor <-- indServ: ok
deactivate indServ

@enduml
