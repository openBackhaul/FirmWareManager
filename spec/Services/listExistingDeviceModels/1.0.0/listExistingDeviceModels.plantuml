@startuml listExistingDeviceModels
skinparam responseMessageBelowArrow true

title
  listExistingDeviceModels
end title

participant "requestor\n" as requestor
participant "listExistingDeviceModels\n" as cur
database "RunningDS" as RunDS

requestor -> cur
activate cur

  note over cur
    Retrieves DeviceModels
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS

requestor <-- cur: [ {deviceModelName,\ndefaultDeviceGroup} ]
deactivate cur

@enduml
