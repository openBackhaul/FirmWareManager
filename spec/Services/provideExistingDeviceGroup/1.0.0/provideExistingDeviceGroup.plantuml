@startuml provideExistingDeviceGroup
skinparam responseMessageBelowArrow true

title
  provideExistingDeviceGroup
end title

participant "requestor\n" as requestor
participant "provideExistingDeviceGroup\n" as indServ
database "RunningDS" as RunDS

requestor -> indServ: { deviceGroupLabel }
activate indServ

  note over indServ
    Checks whether given
    deviceGroupLabel exists
    by reading {DeviceGroup}
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: {DeviceGroup}
  deactivate RunDS
  note over indServ
    IF DeviceGroup NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

requestor <-- indServ: { deviceGroupLabel,\ndeviceModelName,\n<color:LightGray>purgeDate</color>,\n[{targetFirmwareList}],\n[deviceList] }
deactivate indServ

@enduml
