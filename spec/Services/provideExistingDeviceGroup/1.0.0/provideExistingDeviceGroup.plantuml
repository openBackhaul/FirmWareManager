@startuml provideExistingDeviceGroup
skinparam responseMessageBelowArrow true

title
  provideExistingDeviceGroup
end title

participant "requestor\n" as requestor
participant "provideExistingDeviceGroup\n" as lResources
database "RunningDS" as RunDS

requestor -> lResources: { deviceGroupLabel }
activate lResources

  note over lResources
    Retrieves data
    from RunningDS
  end note
  lResources -> RunDS
  activate RunDS
  lResources <-- RunDS
  deactivate RunDS

requestor <-- lResources: { deviceGroupLabel,\ndeviceModelName,\n<color:LightGray>purgeDate</color>,\n[{targetFirmwareList}],\n[deviceList] }
deactivate lResources

@enduml
