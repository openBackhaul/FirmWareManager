@startuml addDevicesToDeviceGroup
skinparam responseMessageBelowArrow true

title
  addDevicesToDeviceGroup
end title

participant "requestor\n" as requestor
participant "addDevicesToDeviceGroup\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { deviceGroupLabel,\n[mountNameList] }
activate cur

  note over cur
    Checks whether given deviceGroupLabel
    exists by retrieving the DeviceGroup's
    _deviceModel
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF DeviceGroup NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[attributeList] }
  note over cur
    ELSE
  end note

  note over cur
    Checks whether any given
    Devices are not existing by 
    retrieving their deviceModel
  end note
  loop for each mountName in mountNameList
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
  end loop
  note over cur
    IF any Devices NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[mountNameList] }
  note over cur
    ELSE
  end note

  note over cur
    Checks whether value of deviceModel
    at any given Devices differ from value
    of _deviceModel at given DeviceGroup
  end note
  note over cur
    IF any Devices of the wrong deviceModel:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[mountNameList] }
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  loop for each given mountName
    note over cur
      Deletes given mountName from
      _device of other DeviceGroups
    end note
    loop for each DeviceGroup
      note over cur
        Checks, whether mountName
        in _device of DeviceGroup
      end note
      cur -> CanDS
      cur <-- CanDS
      note over cur
        IF mountName in _device:
      end note
      note right cur
        THEN
      end note
      note right cur
        Deletes mountName from _device
      end note
      cur -> CanDS
      cur <-- CanDS
      note over cur
        ELSE
      end note
    end loop

    note over cur
      Adds given mountName to
      _device at given DeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS

    note over cur
      Deletes existing contents
      of firmwareList at Device
    end note
    cur -> CanDS
    cur <-- CanDS

    note over cur
      Transfers content of 
      targetFirmwareList
      of DeviceGroup into
      firmwareList at Device
    end note
    note right cur
      Reads targetFirmwareList from DeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS
    note right cur
      Updates firmwareList at Device
    end note
    cur -> CanDS
    cur <-- CanDS
  end loop

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==addDevicesToDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
