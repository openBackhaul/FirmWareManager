@startuml addDevicesToDeviceGroup
skinparam responseMessageBelowArrow true

title
  addDevicesToDeviceGroup
end title

participant "requestor\n" as requestor
participant "addDevicesToDeviceGroup\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceGroupLabel,\n[mountNameList] }
activate indServ

  note over indServ
    Checks whether given deviceGroupLabel
    exists by retrieving the DeviceGroup's
    targetFirmwareList
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note over indServ
    IF DeviceGroup NOT existing:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\n[attributeList] }
  note over indServ
    ELSE
  end note

  note over indServ
    Checks whether any given
    Devices are not existing by 
    retrieving their deviceModel
  end note
  loop for each mountName in mountNameList
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS
    deactivate RunDS
  end loop
  note over indServ
    IF any Devices NOT existing:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\n[mountNameList] }
  note over indServ
    ELSE
  end note

  note over indServ
    Checks whether any given
    Devices have different 
    deviceModel than given
    DeviceGroup
  end note
  note over indServ
    IF any Devices of the wrong deviceModel:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\n[mountNameList] }
  note over indServ
    ELSE
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  loop for each given mountName
    note over indServ
      Deletes given mountName from
      _device of other DeviceGroups
    end note
    loop for each DeviceGroup
      note over indServ
        Checks, whether mountName
        in _device of DeviceGroup
      end note
      indServ -> CanDS
      indServ <-- CanDS
      note over indServ
        IF mountName in _device:
      end note
      note right indServ
        THEN
      end note
      note right indServ
        Deletes mountName from _device
      end note
      indServ -> CanDS
      indServ <-- CanDS
      note over indServ
        ELSE
      end note
    end loop

    note over indServ
      Adds given mountName to
      _device at given DeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Deletes existing contents
      of firmwareList at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Copies content of 
      targetFirmwareList
      of DeviceGroup into
      firmwareList at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==addDevicesToDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage }
  note over indServ
    ELSE
  end note

  note right indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

  requestor <-- indServ: 204

deactivate indServ

@enduml
