@startuml deleteDeviceModel
skinparam responseMessageBelowArrow true

title
  deleteDeviceModel
end title

participant "requestor\n" as requestor
participant "deleteDeviceModel\n" as delDevMod
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> delDevMod: { deviceModelName }
activate delDevMod

  note over delDevMod
    Checks whether given
    deviceModelName exists
  end note
  delDevMod -> RunDS
  activate RunDS
  delDevMod <-- RunDS
  deactivate RunDS
  note over delDevMod
    IF DeviceModel NOT existing:
  end note
  note left delDevMod
    THEN
  end note
  requestor <-- delDevMod: 204
  note over delDevMod
    ELSE
  end note

  note over delDevMod
    Checks, whether there are any Devices
    of the to be deleted DeviceModel
  end note
  loop for each existing DeviceGroup
    note over delDevMod
      Checks, whether _deviceModel
      in DeviceGroup references the
      given DeviceModel
    end note
    delDevMod -> RunDS
    activate RunDS
    delDevMod <-- RunDS
    deactivate RunDS
    note over delDevMod
      IF given DeviceModel referenced:
    end note
    note right delDevMod
      THEN
    end note
      note right delDevMod
        Reads Devices that are
        referenced in _devices
      end note
      delDevMod -> RunDS
      activate RunDS
      delDevMod <-- RunDS
      deactivate RunDS
    note over delDevMod
      ELSE
    end note
  end loop
  note over delDevMod
    IF Devices of the to be
    deleted DeviceModel found:
  end note
  note left delDevMod
    THEN
  end note
  requestor <-- delDevMod: { ErrorCode,\nErrorMessage,\n[listOfReferencingObjects] }
  note over delDevMod
    ELSE
  end note

  note over delDevMod
    Locks RunningDS
  end note
  delDevMod -X RunDS
  activate RunDS
  note over delDevMod
    Locks CandidateDS
  end note
  delDevMod -X CanDS
  activate CanDS
  note over delDevMod
    Overwrites
    CandidateDS
    with RunningDS
  end note
  delDevMod -> RunDS
  RunDS -/ CanDS

  note over delDevMod
    Deletes referencing
    DeviceGroups
  end note
  loop for each existing DeviceGroup
    note over delDevMod
      Reads deviceModel
    end note
    delDevMod -> CanDS
    delDevMod <-- CanDS
    note over delDevMod
      IF given DeviceModel referenced:
    end note
    note right delDevMod
      THEN
    end note
    note right delDevMod
      Deletes DeviceGroup
    end note
    delDevMod -> CanDS
    delDevMod <-- CanDS
    note over delDevMod
      ELSE
    end note
  end loop

  note right delDevMod
    Deletes given DeviceModel
  end note
  delDevMod -> CanDS
  delDevMod <-- CanDS

  note over delDevMod
    Triggers Validation
  end note
  delDevMod -> valiMan: {triggerFunction==deleteDeviceModel}
  activate valiMan
    note over valiMan
      Validates
    end note
  delDevMod <-- valiMan
  deactivate valiMan
  note over delDevMod
    IF validation failed:
  end note
  note left delDevMod
    THEN
  end note
  requestor <-- delDevMod: { ErrorCode,\nErrorMessage }
  note over delDevMod
    ELSE
  end note

  note right delDevMod
    Overwrites RunningDS
    with CandidateDS
  end note
  delDevMod -> CanDS
  CanDS -\ RunDS
  note right delDevMod
    Unlocks CandidateDS
  end note
  delDevMod -X CanDS
  deactivate CanDS
  note right delDevMod
    Unlocks RunningDS
  end note
  delDevMod -X RunDS
  deactivate RunDS

  requestor <-- delDevMod: 204

deactivate delDevMod

@enduml
