@startuml completeness
skinparam responseMessageBelowArrow true

title
test.completeness
end title

participant "Postman\n" as Postman #Orange 
participant "Data\n" as Data
participant "Collection\n" as Collection


participant "updateEsAddress" as cur #LightBlue



group Preparation
  Data --\\o Postman : {servers, esName, url, apiKey, indexAlias, serviceRecordsPolicy, operationalSate, lifeCycleState}
  activate Postman
  Postman --\\o Collection : {servers, esName, url, apiKey, indexAlias, serviceRecordsPolicy, operationalSate, lifeCycleState}
end

group completeness test
  Collection --\\o Postman: {servers}
  Postman -> cur: {esName, url, apiKey, indexAlias, serviceRecordsPolicy, operationalSate, lifeCycleState}
  cur <-- Postman: ResponseCode, {ResponseBody}
  note right Postman #Orange
    check for ResponseCode == 204
  end note
end


