@startuml completeness
skinparam responseMessageBelowArrow true

title
test.completeness
end title

participant "Postman\n" as Postman #Orange 
participant "Data\n" as Data
participant "Collection\n" as Collection


participant "createFirmwareResource" as cur #LightBlue



group Preparation
  Data --\\o Postman : {servers, firmwareResourceName, firmwareResourceVersion, serverLabel, sourceUri, fileName}
  activate Postman
  Postman --\\o Collection : {servers, firmwareResourceName, firmwareResourceVersion, serverLabel, sourceUri, fileName}
end

group completeness test
  Collection --\\o Postman: {servers}
  Postman -> cur: {firmwareResourceName, firmwareResourceVersion, serverLabel, sourceUri, fileName}
  cur <-- Postman: ResponseCode, {ResponseBody}
  note right Postman #Orange
    check for ResponseCode == 204
  end note
end


