@startuml createDeviceModel
skinparam responseMessageBelowArrow true

title
  createDeviceModel
end title

participant "requestor\n" as requestor
participant "createDeviceModel\n" as indServ
participant "p1ValidationManager\n" as valiMan

database "CandidateDS" as CanDS
database "RunningDS" as RunDS
database "DomainController" as DC

requestor -> indServ: { deviceModelName,\n<color:LightGray>hardwareExtractionFunction,\n<color:LightGray>firmwareExtractionFunction</color> }
activate indServ

  note over indServ
    Checks whether given
    deviceModelName exists
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note over indServ
    IF DeviceModel already exists:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { 409,\nErrorMessage1 }
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Creates DeviceModel
  end note
  indServ -> CanDS: { name==deviceModelName,\n_defaultDeviceGroup==deviceModelName }
  indServ <-- CanDS

  note over indServ
    Creates default DeviceGroup
  end note
  indServ -> CanDS: { label==deviceModelName,\n_deviceModel==deviceModelName }
  indServ <-- CanDS

  note over indServ
    Adds all existing Devices with
    deviceModel==deviceModelName
    to default DeviceGroup
  end note
  note over indServ
    Reads [Device]
  end note
  indServ -> CanDS
  indServ <-- CanDS
  loop for each existing Device
    note over indServ
      IF deviceModel==deviceModelName:
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      Appends mountName to
      [device] at default DeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS
    note right indServ
      }
    end note
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: triggerFunction==createDeviceModel
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan: result,\nreason
  deactivate valiMan
  note over indServ
    IF result==failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { 462,\nErrorMessage2 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

  note over indServ
    IF hardwareExtractionFunction.length > 0:
  end note
  note over indServ
    THEN {
  end note
  note right indServ
    Load name of the hardware 
    update function from [Parameter]
  end note
  indServ -> DC: /function=createDeviceModel/parameter=updateHwFunction/value
  indServ <-- DC: updateHwFunction=p1UpdateHw
  note right indServ
    Checks whether deviceModelName
    already exists in [Parameter]
    of the p1UpdateHw Function
  end note
  indServ -> DC: /function=p1UpdateHw/parameter={deviceModelName}
  note right indServ
    IF deviceModelName already exists:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Overwrites its parameterValue
    with hardwareExtractionFunction
  end note
  indServ -> DC: /function=p1UpdateHw/parameter={deviceModelName}/value\nhardwareExtractionFunction
  note right indServ
    }
  end note
  note right indServ
    ELSE {
  end note
  note right indServ
    Adds deviceModelName as parameterName
    to [Parameter] of the p1UpdateHw
    Function and hardwareExtractionFunction
    as corresponding parameterValue.
  end note
  indServ -> DC: /function=p1UpdateHw/parameter={deviceModelName}\n{deviceModelName,hardwareExtractionFunction}
  note right indServ
    }
  end note

  note over indServ
    IF firmwareExtractionFunction.length > 0:
  end note
  note over indServ
    THEN {
  end note
  note right indServ
    Load name of the firmware 
    update function from [Parameter]
  end note
  indServ -> DC: /function=createDeviceModel/parameter=updateFwFunction/value
  indServ <-- DC: updateFwFunction=p1UpdateFw
  note right indServ
    Checks whether deviceModelName
    already exists in [Parameter]
    of the p1UpdateFw Function
  end note
  indServ -> DC: /function=p1UpdateFw/parameter={deviceModelName}
  note right indServ
    IF deviceModelName already exists:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Overwrites its parameterValue
    with firmwareExtractionFunction
  end note
  indServ -> DC: /function=p1UpdateFw/parameter={deviceModelName}/value\nfirmwareExtractionFunction
  note right indServ
    }
  end note
  note right indServ
    ELSE {
  end note
  note right indServ
    Adds deviceModelName as parameterName
    to [Parameter] of the p1UpdateFw
    Function and firmwareExtractionFunction
    as corresponding parameterValue.
  end note
  indServ -> DC: /function=p1UpdateFw/parameter={deviceModelName}\n{deviceModelName,firmwareExtractionFunction}
  note right indServ
    }
  end note

requestor <-- indServ: 204
deactivate indServ

@enduml
