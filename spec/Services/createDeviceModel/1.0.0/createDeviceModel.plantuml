@startuml createDeviceModel
skinparam responseMessageBelowArrow true

title
  createDeviceModel
end title

participant "requestor\n" as requestor
participant "createDeviceModel\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { deviceModelName }
activate cur

  note over cur
    Checks, whether
    DeviceModel
    already exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF DeviceModel already exists:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: 204
  note over cur
    ELSE
  end note  

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Creates DeviceModel
  end note
  cur -> CanDS: { name==deviceModelName,\n_defaultDeviceGroup==deviceModelName }
  cur <-- CanDS

  note over cur
    Creates default DeviceGroup
  end note
  cur -> CanDS: { label==deviceModelName,\n_deviceModel==deviceModelName }
  cur <-- CanDS

  note over cur
    Adds all existing Devices with
    deviceModel==deviceModelName
    to default DeviceGroup
  end note
  loop for each existing Device
    note over cur
      Reads deviceModel
    end note
    cur -> CanDS
    cur <-- CanDS
    note over cur
      IF deviceModel==deviceModelName:
    end note
    note right cur
      THEN
    end note
    note right cur
      Appends mountName to
      _device of default DeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS
  end loop

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==createDeviceModel}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
