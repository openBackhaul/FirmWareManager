@startuml removeDevicesFromDeviceGroup
skinparam responseMessageBelowArrow true

title
  removeDevicesFromDeviceGroup
end title

participant "requestor\n" as requestor
participant "removeDevicesFromDeviceGroup\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceGroupLabel,\n[mountNameList] }
activate indServ

  note over indServ
    Checks whether given
    deviceGroupLabel exists
    by reading the deviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: deviceModel
  deactivate RunDS
  note over indServ
    IF DeviceGroup NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Checks, whether
    given DeviceGroup
    is defaultDeviceGroup
  end note
  note right indServ
    Reads defaultDeviceGroup
    from DeviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: defaultDeviceGroup
  deactivate RunDS
  note over indServ
    IF defaultDeviceGroup
        ==given DeviceGroup:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage2 }
  note left indServ
    }
  end note

  note over indServ
    Reduces list of given
    mountNames to those that
    are actually referenced
    by given DeviceGroup
  end note
  note right indServ
    Reads [device] from
    given DeviceGroup
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: [device]
  deactivate RunDS
  note right indServ
    Add all Devices that are
    both given and in [device]
    to [toBeMovedDevice]
  end note
  note over indServ
    IF [toBeMovedDevice].length==0:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: 204
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  loop for each toBeMovedDevice
    note over indServ
      Deletes mountName from
      [device] at given DeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Deletes contents of 
      [firmwareList] at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Searches for any other
      DeviceGroup referencing
      the Device
    end note
    loop for each DeviceGroup
      note over indServ
        Checks whether mountName
        of toBeMovedDevice exists
        in [device] at DeviceGroup
      end note
      indServ -> CanDS
      indServ <-- CanDS
      note over indServ
        IF toBeMovedDevice
                in DeviceGroup:
      end note
      note right indServ
        THEN {
      end note
      note right indServ
        Sets referencingDeviceGroup=label
      end note
      note right indServ
        }
      end note
    end loop
    note over indServ
      IF referencingDeviceGroup.length==0:
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      Writes toBeMovedDevice into
      [device] at defaultDeviceGroup
    end note
    note right indServ
      referencingDeviceGroup==defaultDeviceGroup
    end note
    note right indServ
      }
    end note

    note over indServ
      Transfers content of
      [targetFirmwareList] of
      referencingDeviceGroup to
      [firmwareList] at Device
    end note
    note right indServ
      Reads [targetFirmwareList]
      at referencingDeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS: [targetFirmwareList]
    note right indServ
      Updates [firmwareList] at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==addDevicesToDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage3 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
