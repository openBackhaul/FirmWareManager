@startuml listIncompleteServers
skinparam responseMessageBelowArrow true

title
  listIncompleteServers
end title

participant "requestor\n" as requestor
participant "listIncompleteServers\n" as cur
database "RunningDS" as RunDS

requestor -> cur
activate cur

  note over cur
    Retrieves [Servers]
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS

  loop for each Server
    note over cur
      If NOT
        ( userName.length > 0
        AND
          (password.length > 0
          OR
          sshKey.length > 0 ) )
    end note
    note right cur
      THEN
    end note
    note right cur
      Appends label of Server
      to [incompleteServerList]
    end note
    note over cur
      ELSE
    end note
  end loop

requestor <-- cur: { [incompleteServerList] }
deactivate cur

@enduml
