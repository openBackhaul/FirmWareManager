@startuml createServer
skinparam responseMessageBelowArrow true

title
  createServer
end title

participant "requestor\n" as requestor
participant "createServer\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { serverLabel,\n<color:LightGray>userName,\n<color:LightGray>password,\n<color:LightGray>sshKey</color> }
activate cur

  note over valiMan #Orange
    Es ist fachlich unklar welche Attribute
    zwingend benötigt werden, bzw. welche
    auch fehlen dürfen müssen.
    Ggf. sind Inputparameter hier schwarz zu
    markieren und in der openAPI als required
    zu dokumentieren.
  end note

  note over cur
    Checks, whether given
    serverLabel already exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF Server already exists:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage1 }
  note over cur
    ELSE
  end note

  note over valiMan #Orange
    Ggf. wäre password auf
    Sicherheitsanforderungen
    zu prüfen.
  end note

  note over valiMan #Orange
    Ggf. wäre sshKey auf
    ein Pattern zu prüfen.
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Creates new Server
    with provided attributes
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==createServer}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage2 }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
