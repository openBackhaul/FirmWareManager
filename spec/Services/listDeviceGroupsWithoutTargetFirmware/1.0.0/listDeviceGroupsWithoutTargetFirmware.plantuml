@startuml listDeviceGroupsWithoutTargetFirmware
skinparam responseMessageBelowArrow true

title
  listDeviceGroupsWithoutTargetFirmware
end title

participant "requestor\n" as requestor
participant "listDeviceGroupsWithoutTargetFirmware\n" as indServ
database "RunningDS" as RunDS

requestor -> indServ
activate indServ

    note over indServ
      Retrieves [DeviceGroup]
    end note
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS: [DeviceGroup]
    deactivate RunDS

  loop for each DeviceGroup
    note over indServ
      If [targetFirmwareList].length NOT > 0
    end note
    note left indServ
      THEN
    end note
    note left indServ
      Appends label of
      DeviceGroup to
      [deviceGroupList]
    end note
    note over indServ
      ELSE
    end note
  end loop

requestor <-- indServ: { [deviceGroupList] }
deactivate indServ

@enduml
