@startuml completeness
skinparam responseMessageBelowArrow true

title
test.completeness
end title

participant "Postman\n" as Postman #Orange 
participant "Data\n" as Data
participant "Collection\n" as Collection


participant "updateDeviceGroup" as cur #LightBlue



group Preparation
  Data --\\o Postman : {servers, deviceGroupLabel, purgeDate}
  activate Postman
  Postman --\\o Collection : {servers, deviceGroupLabel, purgeDate}
end

group completeness test
  Collection --\\o Postman: {servers}
  Postman -> cur: {deviceGroupLabel, purgeDate}
  cur <-- Postman: ResponseCode, {ResponseBody}
  note right Postman #Orange
    check for ResponseCode == 204
  end note
end


