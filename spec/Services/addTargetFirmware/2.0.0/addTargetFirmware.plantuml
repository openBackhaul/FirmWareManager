@startuml addTargetFirmware
skinparam responseMessageBelowArrow true

title
  addTargetFirmware
end title

participant "requestor\n" as requestor
participant "addTargetFirmware\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceGroupLabel,\ntargetFirmwareListName,\nfirmwareResourceName,\nfirmwareResourceVersion,\nfirmwareStatus }
activate indServ

  note over indServ
    Checks whether given
    deviceGroupLabel exists
    by reading deviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: deviceModel
  deactivate RunDS
  note over indServ
    IF DeviceGroup NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { 404,\nErrorMessage1 }
  note left indServ
    }
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion already
    referenced in the given target
    firmware list of given DeviceGroup
  end note
  indServ -> RunDS: /.../device-group={deviceGroupLabel}/{targetFirmwareListName}
  activate RunDS
  indServ <-- RunDS: [givenTargetFirmwareList]
  deactivate RunDS
  note over indServ
    IF FirmwareResource
    already referenced in
    [givenTargetFirmwareList]:
  end note
  note over indServ
    THEN {
  end note
  note left indServ
    Checks whether given
    firmwareStatus equals
    documented status
  end note
  note left indServ
    IF firmwareStatus==status:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: 204
  note left indServ
    }
  end note
  note left indServ
    ELSE {
  end note
  requestor <-- indServ: { 409,\nErrorMessage2 }
  note left indServ
    }
  end note
  note over indServ
    }
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion has
    been approved for deviceModel
  end note
  note over indServ
    Reads [approval]
    from DeviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: [approval]
  deactivate RunDS
  note over indServ
    IF given combination
    NOT in [approval]:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { 422,\nErrorMessage3 }
  note left indServ
    }
  end note

  note over indServ
    Checks whether [givenTargetFirmwareList]
    allows adding another entry
  end note
  note over indServ
    IF ( [givenTargetFirmwareList].maxItems defined AND
         NOT [givenTargetFirmwareList].length<=maxItems ):
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { 422,\nErrorMessage4 }
  note left indServ
    }
  end note

  note over indServ
    Assures maximum one main firmware package
    being active at a time
  end note
  note over indServ
    IF targetFirmwareListName==target-firmware-list
      AND firmwareStatus==active:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    [givenTargetFirmwareList][*].status=stand-by
  end note
  note right indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Appends {newTargetFirmware}
    to target firmware list at
    given DeviceGroup
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Reads [device] at
    given DeviceGroup
  end note
  indServ -> CanDS
  indServ <-- CanDS: [device]
  loop for each referenced Device
    note over indServ
      Appends {newFirmware}
      to firmware list at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: triggerFunction==addTargetFirmware
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan: result,\nreason
  deactivate valiMan
  note over indServ
    IF result==failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { 462,\nErrorMessage5 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
