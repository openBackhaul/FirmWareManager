@startuml addFirmwareApproval
skinparam responseMessageBelowArrow true

title
  addFirmwareApproval
end title

participant "requestor\n" as requestor
participant "addFirmwareApproval\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceModelName,\nfirmwareResourceName,\nfirmwareResourceVersion }
activate indServ

  note over indServ
    Checks whether given
    deviceModelName exists
    by reading DeviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: {DeviceModel}
  deactivate RunDS
  note over indServ
    IF DeviceModel NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion exists
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note over indServ
    IF FirmwareResource NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage2,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion is already
    approved for given DeviceModel
  end note
  note over indServ
    IF given combination of
    firmwareResourceName and
    firmwareResourceVersion
    already in [approval] at
    DeviceModel:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: 204
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Appends combination of
    firmwareResourceName and
    firmwareResourceVersion
    to [approval] at the given
    DeviceModel
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==addFirmwareApproval}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage3 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
