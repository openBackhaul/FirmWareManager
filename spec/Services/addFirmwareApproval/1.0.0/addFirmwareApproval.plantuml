@startuml addFirmwareApproval
skinparam responseMessageBelowArrow true

title
  addFirmwareApproval
end title

participant "requestor\n" as requestor
participant "addFirmwareApproval\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { deviceModelName,\nfirmwareResourceName,\nfirmwareResourceVersion }
activate cur

  note over cur
    Checks whether combination of
    firmwareResourceName and
    firmwareResourceVersion exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF FirmwareResource NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[attributeList] }
  note over cur
    ELSE
  end note

  note over cur
    Checks, whether approval of
    the given FirmwareResource
    already documented at 
    the given DeviceModel
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF approval already documented:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: 204
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Appends combination of 
    firmwareResourceName and 
    firmwareResourceVersion 
    to _approval at the given
    DeviceModel
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==addFirmwareApproval}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
