@startuml removeFirmwareApproval
skinparam responseMessageBelowArrow true

title
  removeFirmwareApproval
end title

participant "requestor\n" as requestor
participant "removeFirmwareApproval\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceModelName,\nfirmwareResourceName,\nfirmwareResourceVersion }
activate indServ

  note over indServ
    Checks whether given
    deviceModelName exists
    by reading DeviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: {DeviceModel}
  deactivate RunDS
  note over indServ
    IF DeviceModel NOT existing:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note over indServ
    ELSE
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion is
    approved for given DeviceModel
  end note
  note over indServ
    IF given combination of
    firmwareResourceName and
    firmwareResourceVersion NOT
    in [approval] at DeviceModel:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: 204
  note over indServ
    ELSE
  end note

  note over indServ
    Checks, whether to be withdrawn
    firmware approval is still base of
    references as target firmware in
    DeviceGroups
  end note
  note over indServ
    Reads [DeviceGroup]
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: [DeviceGroup]
  deactivate RunDS
  loop for each DeviceGroup
    note over indServ
      IF _deviceModel==given deviceModelName
    end note
    note right indServ
      THEN
    end note
    note right indServ
      Checks, whether combination of
      given firmwareResourceName and 
      firmwareResourceVersion is in
      targetFirmwareList
    end note
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS
    deactivate RunDS
    note right indServ
      IF given FirmwareResource
      found in targetFirmwareList
    end note
    note right indServ
      THEN
    end note
    note right indServ
      Appends deviceGroupLabel to
      [listOfReferencingObjects]
    end note
    note right indServ
      ELSE
    end note
    note over indServ
      ELSE
    end note
  end loop
  note over indServ
    IF [listOfReferencingObjects].length > 0:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage2,\n[listOfReferencingObjects] }
  note over indServ
    ELSE
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note right indServ
    Deletes given firmware approval
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==removeFirmwareApproval}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage3 }
  note over indServ
    ELSE
  end note

  note right indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
