@startuml removeFirmwareApproval
skinparam responseMessageBelowArrow true

title
  removeFirmwareApproval
end title

participant "requestor\n" as requestor
participant "removeFirmwareApproval\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { deviceModelName,\nfirmwareResourceName,\nfirmwareResourceVersion }
activate cur

  note over cur
    Checks, whether firmware approval
    with given combination of name and
    version exists at given DeviceModel
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF firmware approval NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: 204
  note over cur
    ELSE
  end note

  note over cur
    Checks, whether to be withdrawn
    firmware approval is still base of
    references as target firmware in
    DeviceGroups
  end note
  loop for each existing DeviceGroup
    note over cur
      Checks, whether _deviceModel 
      matches given deviceModelName
    end note
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
      note over cur
        IF _deviceModel equals
        given deviceModelName
      end note
      note right cur
        THEN
      end note
      note right cur
        Checks, whether combination of
        given firmwareResourceName and 
        firmwareResourceVersion is in
        targetFirmwareList
      end note
      cur -> RunDS
      activate RunDS
      cur <-- RunDS
      deactivate RunDS
      note right cur
        IF given FirmwareResource
        in targetFirmwareList
      end note
      note right cur
        THEN
      end note
      note right cur
        Appends deviceGroupLabel to
        [listOfReferencingObjects]
      end note
      note right cur
        ELSE
      end note
      note over cur
        ELSE
      end note
  end loop
  note over cur
    IF entries in
    [listOfReferencingObjects]
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[listOfReferencingObjects] }
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note right cur
    Deletes given firmware approval
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==removeFirmwareApproval}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
