@startuml listUnknownDeviceModels
skinparam responseMessageBelowArrow true

title
  listUnknownDeviceModels
end title

participant "requestor\n" as requestor
participant "listUnknownDeviceModels\n" as cur
database "RunningDS" as RunDS

requestor -> cur
activate cur

  note over cur
    Retrieves
    [DeviceModels]
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  loop for each Device
    note over cur
      Retrieves deviceModel
    end note
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
    note over cur
      If deviceModel NOT equal to
      any name in [DeviceModels]
    end note
    note right cur
      THEN
    end note
    note right cur
      Appends deviceModel to
      [unknownDeviceModelList]
    end note
    note over cur
      ELSE
    end note
  end loop

requestor <-- cur: { [unknownDeviceModelList] }
deactivate cur

@enduml
