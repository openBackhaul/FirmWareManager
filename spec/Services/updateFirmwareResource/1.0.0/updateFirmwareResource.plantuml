@startuml updateFirmwareResource
skinparam responseMessageBelowArrow true

title
  updateFirmwareResource
end title

participant "requestor\n" as requestor
participant "updateFirmwareResource\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { firmwareResourceName,\nfirmwareResourceVersion,\n<color:LightGray>serverLabel,\n<color:LightGray>sourceUri,\n<color:LightGray>fileName</color> }
activate cur

  note over cur
    Checks, whether given
    combination of
    firmwareResourceName and
    firmwareResourceVersion
    already exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF FirmwareResource NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note over cur #LightBlue
    ELSE unneeded
  end note
  note over cur
    ELSE
  end note

  note over cur
    Checks whether potentially
    given serverLabel exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF serverLabel is given
      AND NOT existing:
  end note
  note left cur
    THEN
  end note  
  requestor <-- cur: { ErrorCode,\nErrorMessage2,\n[attributeList] }
  note over cur #LightBlue
    ELSE unneeded
  end note
  note over cur
    ELSE
  end note

  note over cur
    Checks, whether given
    combination of serverLabel,
    sourceUri and fileName
    already documented
  end note
  loop for each existing FirmwareResource
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
    
    note over cur #LightSalmon
      sollte die Textbox mit dem was gemacht
      werden nicht eher hier drin stehen?
    end note

  end loop
  note over cur
    IF source already documented:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage3,\nfirmwareResourceName }
  note over cur #LightBlue
    ELSE unneeded
  end note
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Uses provided attributes for
    updating FirmwareResource
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==updateFirmwareResource}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage4 }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
