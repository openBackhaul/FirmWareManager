@startuml listDeviceModelsWithoutApprovals
skinparam responseMessageBelowArrow true

title
  listDeviceModelsWithoutApprovals
end title

participant "requestor\n" as requestor
participant "listDeviceModelsWithoutApprovals\n" as indServ
database "RunningDS" as RunDS

requestor -> indServ
activate indServ

  loop for each DeviceModel
    note over indServ
      Reads DeviceModel
    end note
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS: DeviceModel
    deactivate RunDS
    note over indServ
      If [approval].length NOT > 0
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      Appends name of DeviceModel
      to [deviceModelList]
    end note
    note right indServ
      }
    end note
  end loop

requestor <-- indServ: { [deviceModelList] }
deactivate indServ

@enduml
