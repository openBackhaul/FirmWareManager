@startuml deleteServer
skinparam responseMessageBelowArrow true

title
  deleteServer
end title

participant "requestor\n" as requestor
participant "deleteServer\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { serverLabel }
activate indServ

  note over indServ
    Checks whether given
    serverLabel exists
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note over indServ
    IF Server NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Checks, whether any
    existing FirmwareResource
    is referencing given Server
  end note
  loop for each FirmwareResource
    note right indServ
      Reads FirmwareResource
    end note
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS: FirmwareResource
    deactivate RunDS
    note over indServ
      IF server==given Server:
    end note
    note left indServ
      THEN {
    end note
    note left indServ
      Add combination of
      firmwareResourceName and 
      firmwareResourceVersion to
      [referencingObject]
    end note
    note left indServ
      }
    end note
  end loop
  note over indServ
    IF [referencingObject].length > 0:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage2,\n[referencingObject] }
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note right indServ
    Deletes given Server
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==deleteServer}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode3,\nErrorMessage }
  note over indServ
    ELSE
  end note

  note right indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
