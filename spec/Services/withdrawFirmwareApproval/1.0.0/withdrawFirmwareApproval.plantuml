@startuml withdrawFirmwareApproval
skinparam responseMessageBelowArrow true

title
  withdrawFirmwareApproval
end title

participant "requestor\n" as requestor
participant "withdrawFirmwareApproval\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceModelName,\nfirmwareResourceName,\nfirmwareResourceVersion }
activate indServ

  note over indServ
    Checks whether given
    deviceModelName exists
    by reading DeviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: {DeviceModel}
  deactivate RunDS
  note over indServ
    IF DeviceModel NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Checks whether given combination
    of firmwareResourceName and
    firmwareResourceVersion is
    approved for given DeviceModel
  end note
  note over indServ
    IF given combination of
    firmwareResourceName and
    firmwareResourceVersion NOT
    in [approval] at DeviceModel:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: 204
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Deletes given FirmwareResource
    from [approval] at given DeviceModel
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Checks, whether given FirmwareResource
    is still referenced in [targetFirmwareList]
    at DeviceGroups and [firmwareList] at Devices
  end note
  loop for each DeviceGroup
    note over indServ
      Reads DeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS: DeviceGroup
    note over indServ
      IF deviceModel==given deviceModelName
    end note
    note over indServ
      THEN {
    end note
    note right indServ
      Checks, whether given
      FirmwareResource is in
      [targetFirmwareList]
    end note
    note right indServ
      IF given FirmwareResource
      found in [targetFirmwareList]
    end note
    note right indServ
      THEN {
    end note
    note right indServ
      Deletes given FirmwareResource
      from [targetFirmwareList]
    end note
    indServ -> CanDS
    indServ <-- CanDS
    loop for each [device] at DeviceGroup
      note right indServ
        Deletes given
        FirmwareResource
        from [firmwareList]
      end note
      indServ -> CanDS
      indServ <-- CanDS
    end loop
    note right indServ
      }
    end note
    note over indServ
      }
    end note
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==withdrawFirmwareApproval}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage2 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
