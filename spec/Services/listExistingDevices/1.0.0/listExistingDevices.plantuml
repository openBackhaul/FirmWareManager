@startuml listExistingDevices
skinparam responseMessageBelowArrow true

title
  listExistingDevices
end title

participant "requestor\n" as requestor
participant "listExistingDevices\n" as cur
database "RunningDS" as RunDS

requestor -> cur
activate cur

  note over cur
    Retrieves Devices
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS

requestor <-- cur: [ {mountName,\ndeviceModel,\n[firmwareList]} ]
deactivate cur

@enduml
