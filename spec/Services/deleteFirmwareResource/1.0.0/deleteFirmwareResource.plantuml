@startuml deleteFirmwareResource
skinparam responseMessageBelowArrow true

title
  deleteFirmwareResource
end title

participant "requestor\n" as requestor
participant "deleteFirmwareResource\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { firmwareResourceName,\nfirmwareResourceVersion }
activate cur

  note over cur
    Checks, whether FirmwareResource
    with given combination of name and
    version exists
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF FirmwareResource NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: 204
  note over cur
    ELSE
  end note

  note over cur
    Checks, whether any
    existing DeviceGroup
    is referencing given
    FirmwareResource
  end note
  loop for each existing DeviceGroup
    cur -> RunDS
    activate RunDS
    cur <-- RunDS
    deactivate RunDS
  end loop
  note over cur
    IF FirmwareResource still referenced:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\n[listOfReferencingObjects] }
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Cleans up references
  end note
  loop for each existing DeviceModel
    note over cur
      Checks, whether there is an 
      approval of the to be deleted
      FirmwareResource documented
    end note
    cur -> CanDS
    cur <-- CanDS
    note over cur
      IF approval exists:
    end note
    note right cur
      THEN
    end note
    note right cur
      Deletes approval of the
      given FirmwareResource
      from the DeviceModel
    end note
    cur -> CanDS
    cur <-- CanDS
  end loop

  note right cur
    Deletes given FirmwareResource
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==deleteFirmwareResource}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
