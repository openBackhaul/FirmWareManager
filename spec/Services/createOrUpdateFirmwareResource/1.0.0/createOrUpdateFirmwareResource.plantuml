@startuml createOrUpdateFirmwareResource
skinparam responseMessageBelowArrow true

title
  createOrUpdateFirmwareResource
end title

participant "requestor\n" as requestor
participant "createOrUpdateFirmwareResource\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { firmwareResourceName,\nfirmwareResourceVersion,\n<color:LightGray>serverLabel,\n<color:LightGray>sourceUri,\n<color:LightGray>fileName</color> }
activate indServ

  note over indServ #lightcoral
    unlock bei fehlgeschlagener Validierung
    fehlt hier auch
  end note

  note over indServ
    Checks, whether given
    combination of
    firmwareResourceName and
    firmwareResourceVersion
    already documented
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note over indServ
    IF FirmwareResource NOT already existing:
  end note
  note right indServ
    THEN
  end note
  note right indServ
    Checks whether serverLabel,
    sourceUri and fileName are
    all given
  end note
  note right indServ
    IF NOT all attributes given:
  end note
  note right indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\n[attributeList] }
  note right indServ
    ELSE
  end note
  note over indServ
    ELSE
  end note

  note over indServ
    IF serverLabel given:
  end note
  note right indServ
    THEN:
  end note
  note right indServ
    Checks whether
    Server exists
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS
  deactivate RunDS
  note right indServ
    IF Server NOT existing:
  end note
  note right indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\n[attributeList] }
  note right indServ
    ELSE
  end note
  note over indServ
    ELSE
  end note

  note over indServ
    Checks, whether given
    combination of serverLabel,
    sourceUri and fileName
    already documented
  end note
  loop for each existing FirmwareResource
    indServ -> RunDS
    activate RunDS
    indServ <-- RunDS
    deactivate RunDS
  end loop
  note over indServ
    IF source already documented:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage,\nfirmwareResourceName }
  note over indServ
    ELSE
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Checks for existing
    FirmwareResource with
    given name and version
  end note
  indServ -> CanDS
  indServ <-- CanDS
  note over indServ
    IF combination of firmwareResourceName
    and firmwareResourceVersion already exists:
  end note
  note right indServ
    THEN
    - Updates existing FirmwareResource
  end note
  indServ -> CanDS
  indServ <-- CanDS
  note right indServ
    ELSE
    - Creates new FirmwareResource
  end note
  indServ -> CanDS
  indServ <-- CanDS

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==createOrUpdateFirmwareResource}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note left indServ
    THEN
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage }
  note over indServ
    ELSE
  end note

  note right indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

  requestor <-- indServ: 204

deactivate indServ

@enduml
