@startuml deleteDeviceGroup
skinparam responseMessageBelowArrow true

title
  deleteDeviceGroup
end title

participant "requestor\n" as requestor
participant "deleteDeviceGroup\n" as cur
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> cur: { deviceGroupLabel }
activate cur

  note over cur
    Checks, whether given
    DeviceGroup exists by
    reading its deviceModel
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF DeviceGroup NOT existing:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: 204
  note over cur
    ELSE
  end note

  note over cur
    Assures that given DeviceGroup
    is not default DeviceGroup
  end note
  note over cur
    Reads defaultDeviceGroup
    of referenced DeviceModel
  end note  
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS
  note over cur
    IF given deviceGroupLabel
    equals defaultDeviceGroup:
  end note
  note left cur
    THEN
  end note
  requestor <-- cur: { ErrorCode,\nErrorMessage,\nreferencingDeviceModel }
  note over cur
    ELSE
  end note

  note over cur
    Locks RunningDS
  end note
  cur -X RunDS
  activate RunDS
  note over cur
    Locks CandidateDS
  end note
  cur -X CanDS
  activate CanDS
  note over cur
    Overwrites
    CandidateDS
    with RunningDS
  end note
  cur -> RunDS
  RunDS -/ CanDS

  note over cur
    Reads [devices] at
    given DeviceGroup
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Reads [targetFirmwareList]
    at default DeviceGroup
  end note
  cur -> CanDS
  cur <-- CanDS

  note over cur
    Deletes given
    DeviceGroup
  end note
  cur -> CanDS
  cur <-- CanDS

  loop for [devices]
    note over cur
      Appends mountName to [devices]
      of default DeviceGroup
    end note
    cur -> CanDS
    cur <-- CanDS

    note over cur
      Transfers [targetFirmwareList]
      of default DeviceGroup to
      [firmwareList] of Device
    end note
    cur -> CanDS
    cur <-- CanDS
  end loop

  note over cur
    Triggers Validation
  end note
  cur -> valiMan: {triggerFunction==deleteDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  cur <-- valiMan
  deactivate valiMan
  note over cur
    IF validation failed:
  end note
  note right cur
    THEN
  end note
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  requestor <-- cur: { ErrorCode,\nErrorMessage }
  note over cur
    ELSE
  end note

  note right cur
    Overwrites RunningDS
    with CandidateDS
  end note
  cur -> CanDS
  CanDS -\ RunDS
  note right cur
    Unlocks CandidateDS
  end note
  cur -X CanDS
  deactivate CanDS
  note right cur
    Unlocks RunningDS
  end note
  cur -X RunDS
  deactivate RunDS

requestor <-- cur: 204
deactivate cur

@enduml
