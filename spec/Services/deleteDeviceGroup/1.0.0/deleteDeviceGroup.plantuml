@startuml deleteDeviceGroup
skinparam responseMessageBelowArrow true

title
  deleteDeviceGroup
end title

participant "requestor\n" as requestor
participant "deleteDeviceGroup\n" as delGroup
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> delGroup: { deviceGroupLabel }
activate delGroup

  note over delGroup
    Checks, whether given
    deviceGroupLabel exists
  end note
  delGroup -> RunDS
  activate RunDS
  delGroup <-- RunDS
  deactivate RunDS
  note over delGroup
    IF DeviceGroup NOT existing:
  end note
  note left delGroup
    THEN
  end note
  requestor <-- delGroup: 204
  note over delGroup
    ELSE
  end note

  note over delGroup
    Checks, whether to be
    deleted DeviceGroup is
    a default DeviceGroup
  end note
  loop for each existing DeviceModel
    note over delGroup
      Read defaultDeviceGroup
    end note  
    delGroup -> RunDS
    activate RunDS
    delGroup <-- RunDS
    deactivate RunDS
  end loop
  note over delGroup
    IF given deviceGroupLabel
    exists in defaultDeviceGroup:
  end note
  note left delGroup
    THEN
  end note
  requestor <-- delGroup: { ErrorCode,\nErrorMessage,\nreferencingDeviceModel }
  note over delGroup
    ELSE
  end note

  note over delGroup
    Locks RunningDS
  end note
  delGroup -X RunDS
  activate RunDS
  note over delGroup
    Locks CandidateDS
  end note
  delGroup -X CanDS
  activate CanDS
  note over delGroup
    Overwrites
    CandidateDS
    with RunningDS
  end note
  delGroup -> RunDS
  RunDS -/ CanDS

  note over delGroup
    Reads _devices at
    given DeviceGroup
  end note
  delGroup -> CanDS
  delGroup <-- CanDS
  note over delGroup
    IF number of Devices > 0:
  end note
  note right delGroup
    THEN
  end note
  note right delGroup
    Reads deviceModel
    at given DeviceGroup
  end note
  delGroup -> CanDS
  delGroup <-- CanDS
  note right delGroup
    Reads defaultDeviceGroup
    at this DeviceModel
  end note
  delGroup -> CanDS
  delGroup <-- CanDS
  note right delGroup
    Appends all entries of _devices
    at given DeviceGroup to _devices
    at default DeviceGroup
  end note
  delGroup -> CanDS
  delGroup <-- CanDS

  note right delGroup
    Deletes given DeviceGroup
  end note
  delGroup -> CanDS
  delGroup <-- CanDS

  note over delGroup
    Triggers Validation
  end note
  delGroup -> valiMan: {triggerFunction==deleteDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  delGroup <-- valiMan
  deactivate valiMan
  note over delGroup
    IF validation failed:
  end note
  note left delGroup
    THEN
  end note
  requestor <-- delGroup: { ErrorCode,\nErrorMessage }
  note over delGroup
    ELSE
  end note

  note right delGroup
    Overwrites RunningDS
    with CandidateDS
  end note
  delGroup -> CanDS
  CanDS -\ RunDS
  note right delGroup
    Unlocks CandidateDS
  end note
  delGroup -X CanDS
  deactivate CanDS
  note right delGroup
    Unlocks RunningDS
  end note
  delGroup -X RunDS
  deactivate RunDS

  requestor <-- delGroup: 204

deactivate delGroup

@enduml
