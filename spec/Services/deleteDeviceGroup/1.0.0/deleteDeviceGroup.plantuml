@startuml deleteDeviceGroup
skinparam responseMessageBelowArrow true

title
  deleteDeviceGroup
end title

participant "requestor\n" as requestor
participant "deleteDeviceGroup\n" as indServ
participant "p1ValidationManager\n" as valiMan
database "CandidateDS" as CanDS
database "RunningDS" as RunDS

requestor -> indServ: { deviceGroupLabel }
activate indServ

  note over indServ
    Checks whether given
    deviceGroupLabel exists
    by reading its deviceModel
  end note
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: deviceModel
  deactivate RunDS
  note over indServ
    IF DeviceGroup NOT existing:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage1,\n[attributeList] }
  note left indServ
    }
  end note

  note over indServ
    Assures that given DeviceGroup
    is not a default DeviceGroup
  end note
  note right indServ
    Reads defaultDeviceGroup
    of referenced DeviceModel
  end note  
  indServ -> RunDS
  activate RunDS
  indServ <-- RunDS: defaultDeviceGroup
  deactivate RunDS
  note over indServ
    IF defaultDeviceGroup
          ==given deviceGroupLabel:
  end note
  note left indServ
    THEN {
  end note
  requestor <-- indServ: { ErrorCode,\nErrorMessage2,\nreferencingDeviceModel }
  note left indServ
    }
  end note

  note over indServ
    Locks RunningDS
  end note
  indServ -X RunDS
  activate RunDS
  note over indServ
    Locks CandidateDS
  end note
  indServ -X CanDS
  activate CanDS
  note over indServ
    Overwrites
    CandidateDS
    with RunningDS
  end note
  indServ -> RunDS
  RunDS -/ CanDS

  note over indServ
    Reads [device] at
    given DeviceGroup
    (list of mountName 
    (=key attribute value))
  end note
  indServ -> CanDS
  indServ <-- CanDS: [device]

  note over indServ
    Reads [targetFirmwareList]
    at default DeviceGroup
  end note
  indServ -> CanDS
  indServ <-- CanDS: [targetFirmwareList]

  note over indServ
    Deletes given
    DeviceGroup
  end note
  indServ -> CanDS
  indServ <-- CanDS

  loop for each Device
    note over indServ
      Appends mountName to [devices]
      of default DeviceGroup
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Delete existing
      [firmwareList]
      at Device
    end note
    indServ -> CanDS
    indServ <-- CanDS

    note over indServ
      Transfers [targetFirmwareList]
      of default DeviceGroup to
      [firmwareList] of Device
    end note
    indServ -> CanDS
    indServ <-- CanDS
  end loop

  note over indServ
    Triggers Validation
  end note
  indServ -> valiMan: {triggerFunction==deleteDeviceGroup}
  activate valiMan
    note over valiMan
      Validates
    end note
  indServ <-- valiMan
  deactivate valiMan
  note over indServ
    IF validation failed:
  end note
  note right indServ
    THEN {
  end note
  note right indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  note right indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  requestor <-- indServ: { ErrorCode,\nErrorMessage3 }
  note right indServ
    }
  end note

  note over indServ
    Overwrites RunningDS
    with CandidateDS
  end note
  indServ -> CanDS
  CanDS -\ RunDS
  note over indServ
    Unlocks CandidateDS
  end note
  indServ -X CanDS
  deactivate CanDS
  note over indServ
    Unlocks RunningDS
  end note
  indServ -X RunDS
  deactivate RunDS

requestor <-- indServ: 204
deactivate indServ

@enduml
