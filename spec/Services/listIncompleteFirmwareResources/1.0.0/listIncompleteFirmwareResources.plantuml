@startuml listIncompleteFirmwareResources
skinparam responseMessageBelowArrow true

title
  listIncompleteFirmwareResources
end title

participant "requestor\n" as requestor
participant "listIncompleteFirmwareResources\n" as cur
database "RunningDS" as RunDS

requestor -> cur
activate cur

  note over cur
    Retrieves
    [FirmwareResources]
  end note
  cur -> RunDS
  activate RunDS
  cur <-- RunDS
  deactivate RunDS

  loop for each FirmwareResource
    note over cur
      If NOT
          ( server.length > 0
          AND
          sourceUri.length > 0
          AND
          fileName.length > 0 )
    end note
    note right cur
      THEN
    end note
    note right cur
      Appends combination of name and
      version of FirmwareResource to
      [incompleteFirmwareResourceList]
    end note
    note over cur
      ELSE
    end note
  end loop

requestor <-- cur: { [incompleteFirmwareResourceList] }
deactivate cur

@enduml
