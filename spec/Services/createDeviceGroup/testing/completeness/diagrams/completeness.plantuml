@startuml completeness
skinparam responseMessageBelowArrow true

title
test.completeness
end title

participant "Postman\n" as Postman #Orange 
participant "Data\n" as Data
participant "Collection\n" as Collection


participant "createDeviceGroup" as cur #LightBlue



group Preparation
  Data --\\o Postman : {servers, deviceGroupLabel, deviceModelName, purgeDate}
  activate Postman
  Postman --\\o Collection : {servers, deviceGroupLabel, deviceModelName, purgeDate}
end

group completeness test - all parameters
  Collection --\\o Postman: {servers, deviceGroupLabel, deviceModelName, purgeDate}
  Postman -> cur: {deviceGroupLabel, deviceModelName, purgeDate}
  cur <-- Postman: ResponseCode, {ResponseBody}
  note right Postman #Orange
    check for ResponseCode == 204
  end note
end


group completeness test - required parameters only
  Collection --\\o Postman: {servers, deviceGroupLabel, deviceModelName}
  Postman -> cur: {deviceGroupLabel, deviceModelName}
  cur <-- Postman: ResponseCode, {ResponseBody}
  note right Postman #Orange
    check for ResponseCode == 204
  end note
end


